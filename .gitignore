# Paths below are ROOT-ANCHORED with a leading slash, deliberately.
#
# A bare `evidence/` matches at ANY depth, so it silently excluded
# `src/evidence/` — the entire evidence module, manifest + redaction + store —
# from the first push. Everything built and tested locally because the files
# were on disk; a clean clone did not compile. Anchor anything that names a
# run-output directory whose name could collide with a source directory.

node_modules/
*.tsbuildinfo

/coverage/
/dist/

# Run output. May contain personal data captured from a page — see
# src/evidence/redact.ts for what is stripped before it reaches disk.
/evidence/
/experiments/*/evidence/
/experiments/*/results.jsonl

# Local config carries proxy credentials.
/geoqa.config.json
.env
.env.*
!.env.example

# Service-account JSON and anything else pulled from the fleet VPS.
secrets/

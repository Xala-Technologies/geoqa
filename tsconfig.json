{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@geoqa/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "vitest.config.ts", "vitest.e2e.config.ts"],
  "exclude": ["node_modules", "evidence", "experiments/**/evidence"]
}

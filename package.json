{
  "name": "@xala-technologies/geoqa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Geographic experience & evidence engine — validates what a visitor in a given market actually experiences, and proves it.",
  "type": "module",
  "scripts": {
    "geoqa": "pnpm --filter @geoqa/engine geoqa",
    "worker": "pnpm --filter @geoqa/engine worker",
    "typecheck": "pnpm --filter @geoqa/engine typecheck && pnpm --filter @geoqa/console typecheck && tsc --noEmit",
    "lint": "pnpm typecheck",
    "boundaries": "pnpm --filter @geoqa/engine boundaries",
    "test": "pnpm --filter @geoqa/engine test && pnpm --filter @geoqa/console test",
    "test:watch": "pnpm --filter @geoqa/engine test:watch",
    "test:coverage": "pnpm --filter @geoqa/engine test:coverage",
    "test:e2e": "pnpm --filter @geoqa/engine test:e2e",
    "browser:install": "pnpm --filter @geoqa/engine browser:install",
    "playwright:install": "pnpm --filter @geoqa/engine playwright:install",
    "dev": "pnpm --filter @geoqa/console dev",
    "ui:dev": "pnpm --filter geoqa-ui dev",
    "ui:build": "pnpm --filter geoqa-ui build",
    "test:ui": "pnpm --filter geoqa-ui test:coverage",
    "test:console": "pnpm --filter @geoqa/console test"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@types/node": "^22.16.5",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "agent-browser",
      "esbuild",
      "protobufjs"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
